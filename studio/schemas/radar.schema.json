{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VilaDoPuloRadar",
  "type": "object",
  "required": ["week", "channels", "steal_patterns", "do_not_copy", "keep_or_kill"],
  "properties": {
    "week": { "type": "string" },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handle", "titles"],
        "properties": {
          "handle": { "type": "string" },
          "titles": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "steal_patterns": { "type": "array", "items": { "type": "string" } },
    "do_not_copy": { "type": "array", "items": { "type": "string" } },
    "keep_or_kill": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "retention_pct", "decision"],
        "properties": {
          "format": { "type": "string" },
          "retention_pct": { "type": "number" },
          "decision": { "type": "string", "enum": ["keep", "kill", "watch"] }
        }
      }
    }
  }
}
